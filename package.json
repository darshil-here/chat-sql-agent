{
  "name": "querymind",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "description": "Natural language to SQL chat app with FTS5 schema retrieval, a read-only query guard, and a seeded SQLite database.",
  "keywords": [
    "nextjs",
    "ai-sdk",
    "openrouter",
    "sql",
    "text-to-sql",
    "rag",
    "fts5",
    "turso",
    "drizzle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darshil-here/chat-sql-agent.git"
  },
  "homepage": "https://chat-sql-agent.vercel.app",
  "bugs": {
    "url": "https://github.com/darshil-here/chat-sql-agent/issues"
  },
  "author": "Darshil Prajapati",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/db.seed.ts",
